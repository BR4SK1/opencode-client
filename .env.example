# NextAuth
AUTH_SECRET=
# generate: openssl rand -base64 32

# OIDC provider (NextAuth generic provider)
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=

# OpenCode server
OPENCODE_BASE_URL=http://localhost:4096
# Optional. Sent VERBATIM as the Authorization header value, e.g.:
#   Basic $(printf 'opencode:PASSWORD' | base64)
#   Bearer TOKEN
OPENCODE_TOKEN=

# Local-only demo bypass. When "true" AND no OIDC credentials are configured,
# the sign-in page offers a fake local demo user (no real auth). The app
# refuses to start with AUTH_DEMO=true when NODE_ENV=production. Default false.
AUTH_DEMO=false
